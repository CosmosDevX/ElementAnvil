{
  "name": "unexplored-editor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "CosmosDevX",
  "description": "Desktop code editor for Zig and 1C Element",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.mjs",
    "build:win": "electron-builder --win --x64 --publish never",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/integration.mjs",
    "fonts": "node scripts/bundle-fonts.mjs",
    "verify:element": "node scripts/verify-element.mjs",
    "prestart": "node scripts/bundle-markdown.mjs && node node_modules/electron/install.js",
    "format": "prettier --write \"{desktop,lib,public,scripts,tests}/**/*.{mjs,js,html,css}\" server.mjs package.json README.md",
    "prebuild:win": "node scripts/bundle-markdown.mjs",
    "prestart:web": "node scripts/bundle-markdown.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "monaco-editor": "0.57.0"
  },
  "build": {
    "appId": "dev.cosmosdevx.unexplorededitor",
    "productName": "UnexploredEditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "public/**",
      "lib/**",
      "server.mjs",
      "examples/**",
      "package.json",
      "node_modules/monaco-editor/min/**",
      "node_modules/monaco-editor/LICENSE",
      "build/icon.ico"
    ],
    "asar": true,
    "compression": "store",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "UnexploredEditor-${version}-Portable.exe",
      "signAndEditExecutable": true
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "fileAssociations": [
      {
        "ext": "sbsl",
        "name": "1С:Элемент Скрипт",
        "description": "Исходный код 1С:Элемент",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "UnexploredEditor-${version}-Setup.exe",
      "shortcutName": "UnexploredEditor",
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10"
  }
}
