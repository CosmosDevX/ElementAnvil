{
  "name": "unexplored-editor",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "CosmosDevX",
  "description": "Desktop code editor for 1C Element",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.mjs",
    "build:win": "electron-builder --win --x64 --publish never",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:lsp": "node scripts/check-element-lsp.mjs",
    "test:debug": "node scripts/check-element-debug.mjs",
    "test:terminal": "node scripts/check-terminal.mjs",
    "fonts": "node scripts/bundle-fonts.mjs",
    "verify:element": "node scripts/verify-element.mjs",
    "prestart": "node scripts/bundle-markdown.mjs && node scripts/bundle-terminal.mjs && node node_modules/electron/install.js",
    "format": "prettier --write \"{desktop,lib,public,scripts,tests}/**/*.{mjs,js,html,css}\" server.mjs package.json README.md",
    "prebuild:win": "node scripts/bundle-markdown.mjs && node scripts/bundle-terminal.mjs",
    "prestart:web": "node scripts/bundle-markdown.mjs && node scripts/bundle-terminal.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "monaco-editor": "0.57.0",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "dev.cosmosdevx.unexplorededitor",
    "productName": "Element Anvil",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "public/**",
      "lib/**",
      "server.mjs",
      "examples/**",
      "package.json",
      "node_modules/monaco-editor/min/**",
      "node_modules/monaco-editor/LICENSE",
      "build/icon.ico",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/monaco-editor/min-maps/**",
      "!node_modules/@xterm/**",
      "!node_modules/node-addon-api/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/third_party/**",
      "!node_modules/node-pty/build/**",
      "!node_modules/node-pty/prebuilds/darwin-*/**",
      "!node_modules/node-pty/prebuilds/linux-*/**",
      "!node_modules/node-pty/prebuilds/win32-arm64/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.pdb",
      "!node_modules/**/*.ts",
      "!node_modules/**/{test,tests,docs,examples,benchmark}/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "ElementAnvil-${version}-Portable.exe",
      "signAndEditExecutable": true
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "fileAssociations": [
      {
        "ext": "sbsl",
        "name": "1С:Элемент Скрипт",
        "description": "Исходный код 1С:Элемент",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ElementAnvil-${version}-Setup.exe",
      "shortcutName": "Element Anvil",
      "createDesktopShortcut": true
    },
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10"
  }
}
